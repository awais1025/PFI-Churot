@{
    string controller = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString().ToLower();
    string action = HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString().ToLower();

    bool search = Session["Search"] != null ? (bool)Session["Search"] : false;
    string searchString = Session["SearchString"] != null ? (string)Session["SearchString"] : "";

    bool userConnected = Models.User.ConnectedUser != null;
    bool userIsAdmin = userConnected ? Models.User.ConnectedUser.IsAdmin : false;
    bool userCanWrite = userConnected ? Models.User.ConnectedUser.CanWrite : false;
}

<div class="section roundedBorder" style="margin-bottom: 0px;">
    <div class="headerMenu" style="display: flex; justify-content: space-between; align-items: center; padding: 10px; background-color: #f8f9fa; border-bottom: 1px solid #ddd;">

        <!-- Titre dynamique -->
        <div style="display: flex; align-items: center; gap: 10px;">
            @if (controller == "students")
            {
                <h2 style="margin: 0; font-size: 1.5em;">
                    <i class="fa fa-user" style="color: #c00;"></i>
                    <strong style="color: #333;">Étudiants</strong>
                    <span style="color: #aaa; font-weight: normal; font-size: 0.8em; margin-left: 5px;">Cours Profs</span>
                </h2>
            }
            else if (controller == "courses")
            {
                <h2 style="margin: 0; font-size: 1.5em;">
                    <i class="fa fa-book" style="color: #c00;"></i>
                    <span style="color: #aaa; font-weight: normal; font-size: 0.8em; margin-right: 5px;">Étudiants</span>
                    <strong style="color: #333;">Cours</strong>
                    <span style="color: #aaa; font-weight: normal; font-size: 0.8em; margin-left: 5px;">Profs</span>
                </h2>
            }
            else if (controller == "teachers")
            {
                <h2 style="margin: 0; font-size: 1.5em;">
                    <i class="fa fa-chalkboard-user" style="color: #c00;"></i>
                    <span style="color: #aaa; font-weight: normal; font-size: 0.8em; margin-right: 5px;">Étudiants Cours</span>
                    <strong style="color: #333;">Profs</strong>
                </h2>
            }
            else
            {
                <h2 style="margin: 0; font-size: 1.5em;">@ViewBag.PageTitle</h2>
            }
        </div>

        <!-- Menus et Boutons -->
        <div id="mainMenuPanel" class="menu" style="display: flex; gap: 15px; font-size: 1.2em; color: #0056b3; align-items: center;">
            @switch (action)
            {
                case "index":
                case "list":
                    if (userCanWrite)
                    {
                        <a href="/@controller/Create" class="cmdIcon fa fa-circle-plus" style="color: inherit; text-decoration: none;" title="Ajouter..."></a>
                    }

                    <!-- La loupe de recherche -->
                    <i class="cmdIcon fa fa-search" id="toggleSearch" style="cursor: pointer; color: inherit;" title="Rechercher"></i>

                    <!-- Dropdown Menu -->
                    <div id="menu" class="dropdown ms-auto">
                        <div data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer; color: inherit;">
                            <i class="cmdIcon fa fa-bars" title="Menu"></i>
                        </div>
                        <div class="dropdown-menu noselect" id="DDMenu">
                            <div class="dropdown-item">
                                <i class="fa fa-address-card"></i> <a href="/Accounts/EditProfil" style="text-decoration: none; color: inherit;">Profil...</a>
                            </div>
                            <div class="dropdown-item">
                                <i class="fa fa-sign-out"></i> <a href="/Accounts/Logout" style="text-decoration: none; color: inherit;">Déconnexion...</a>
                            </div>

                            @if (userIsAdmin)
                            {
                                <div class="dropdown-divider"></div>
                                <div class="dropdown-item">
                                    <i class="fa fa-users"></i> <a href="/Accounts/ManageUsers" style="text-decoration: none; color: inherit;">Gestion des usagers...</a>
                                </div>
                                <div class="dropdown-item">
                                    <i class="fa fa-calendar-days"></i> <a href="/Accounts/LoginsJournal" style="text-decoration: none; color: inherit;">Historique de connexions...</a>
                                </div>
                                <div class="dropdown-item">
                                    <i class="fa fa-gear"></i> <a href="/Accounts/EventsJournal" style="text-decoration: none; color: inherit;">Journal d'activités...</a>
                                </div>
                            }
                        </div>
                    </div>
                    break;

                case "details":
                    if (userCanWrite)
                    {
                        <a href="/@controller/Edit/@ViewContext.RouteData.Values["id"]" class="cmdIcon fa fa-pen-to-square" style="color: inherit; text-decoration: none;" title="Modifier..."></a>
                        <i class="cmdIcon fa fa-trash-can" style="color: red; cursor: pointer;"
                           title="Effacer"
                           onclick="bootbox.confirm('Voulez-vous vraiment effacer cet enregistrement ?', function(result){ if (result) window.location = '/@controller/Delete/@ViewContext.RouteData.Values["id"]'; })">
                        </i>
                    }
                    <a href="/@controller/List" class="cmdIcon fa fa-square-xmark" style="color: gray; text-decoration: none;" title="Retour"></a>
                    break;

                case "create":
                case "edit":
                    if (userCanWrite)
                    {
                        <i class="cmdIcon submitCmd fa fa-circle-check" style="color: green; cursor: pointer;" title="Soumettre" onclick="document.getElementById('submit').click()"></i>
                        <a href="/@controller/List" class="cmdIcon fa fa-square-xmark" style="color: gray; text-decoration: none;" title="Annuler"></a>
                    }
                    break;
            }
        </div>
    </div>
</div>

<!-- Barre de recherche CACHÉE par défaut avec display: none -->
@if (search && (action == "list" || action == "index"))
{
    <div id="searchContainer" class="searchBar" style="padding: 10px; background-color: #f1f1f1; border-bottom: 1px solid #ddd; display: none;">
        <form id="searchForm">
            <input type="search" name="searchString" id="searchInput" class="form-control" value="@searchString" placeholder="Rechercher par matricule ou nom...">
        </form>
    </div>
}